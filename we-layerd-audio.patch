diff --git a/src/audio.rs b/src/audio.rs
new file mode 100644
index 0000000..fa6bce9
--- /dev/null
+++ b/src/audio.rs
@@ -0,0 +1,189 @@
+use std::{
+    mem,
+    ptr,
+    sync::{
+        atomic::{AtomicPtr, Ordering},
+        mpsc::Sender,
+        Arc,
+    },
+    thread,
+};
+
+use anyhow::{Context, Result};
+use pipewire as pw;
+use pw::{properties::properties, spa};
+use spa::param::format::{MediaSubtype, MediaType};
+use spa::pod::Pod;
+
+/// The renderer rejects audio pushes larger than 4096 floats, so each
+/// capture chunk is capped at 1024 stereo frames (2048 floats).
+const MAX_FRAMES_PER_PUSH: usize = 1024;
+
+struct UserData {
+    format: spa::param::audio::AudioInfoRaw,
+    tx: Sender<Vec<f32>>,
+}
+
+/// Captures system audio (the default sink monitor) through PipeWire and
+/// forwards interleaved f32 samples through an mpsc channel.
+pub(crate) struct SystemAudioCapture {
+    quit_ptr: Arc<AtomicPtr<pw::sys::pw_main_loop>>,
+    join: Option<thread::JoinHandle<()>>,
+}
+
+impl SystemAudioCapture {
+    pub(crate) fn spawn(tx: Sender<Vec<f32>>) -> Self {
+        let quit_ptr = Arc::new(AtomicPtr::new(ptr::null_mut()));
+        let thread_quit_ptr = Arc::clone(&quit_ptr);
+        let join = thread::spawn(move || {
+            let _ = run_capture(thread_quit_ptr, tx);
+        });
+        Self { quit_ptr, join: Some(join) }
+    }
+
+    /// Stop the capture main loop and wait for the thread to exit.
+    pub(crate) fn quit(&mut self) {
+        let ptr = self.quit_ptr.load(Ordering::SeqCst);
+        if !ptr.is_null() {
+            // pw_main_loop_quit is documented as safe to call from any thread.
+            unsafe {
+                pw::sys::pw_main_loop_quit(ptr);
+            }
+        }
+        if let Some(join) = self.join.take() {
+            let _ = join.join();
+        }
+    }
+}
+
+impl Drop for SystemAudioCapture {
+    fn drop(&mut self) {
+        self.quit();
+    }
+}
+
+fn run_capture(quit_ptr: Arc<AtomicPtr<pw::sys::pw_main_loop>>, tx: Sender<Vec<f32>>) -> Result<()> {
+    pw::init();
+
+    let mainloop =
+        pw::main_loop::MainLoopRc::new(None).context("failed to create pipewire main loop")?;
+    quit_ptr.store(mainloop.as_raw_ptr(), Ordering::SeqCst);
+
+    let context = pw::context::ContextRc::new(&mainloop, None)
+        .context("failed to create pipewire context")?;
+    let core = context.connect_rc(None).context("failed to connect to pipewire")?;
+
+    // media.role=ScreenCapture plus STREAM_CAPTURE_SINK makes WirePlumber
+    // connect us to the monitor of the default audio sink, i.e. exactly what
+    // the system is playing.
+    let props = properties! {
+        *pw::keys::MEDIA_TYPE => "Audio",
+        *pw::keys::MEDIA_CATEGORY => "Capture",
+        *pw::keys::MEDIA_ROLE => "ScreenCapture",
+        *pw::keys::STREAM_CAPTURE_SINK => "true",
+        *pw::keys::NODE_NAME => "we-layerd-audio-capture",
+    };
+
+    let stream = pw::stream::StreamBox::new(&core, "we-layerd-audio-capture", props)
+        .context("failed to create pipewire capture stream")?;
+
+    let _listener = stream
+        .add_local_listener_with_user_data(UserData {
+            format: spa::param::audio::AudioInfoRaw::default(),
+            tx,
+        })
+        .param_changed(|_, user_data, id, param| {
+            let Some(param) = param else { return };
+            if id != pw::spa::param::ParamType::Format.as_raw() {
+                return;
+            }
+            let Ok((media_type, media_subtype)) = spa::param::format_utils::parse_format(param)
+            else {
+                return;
+            };
+            if media_type != MediaType::Audio || media_subtype != MediaSubtype::Raw {
+                return;
+            }
+            let _ = user_data.format.parse(param);
+        })
+        .process(|stream, user_data| {
+            let Some(mut buffer) = stream.dequeue_buffer() else {
+                return;
+            };
+            let datas = buffer.datas_mut();
+            if datas.is_empty() {
+                return;
+            }
+            let data = &mut datas[0];
+            let channels = user_data.format.channels() as usize;
+            if channels == 0 {
+                return;
+            }
+            let chunk_size = data.chunk().size() as usize;
+            let Some(samples) = data.data() else {
+                return;
+            };
+            let n_samples = chunk_size / mem::size_of::<f32>();
+            if n_samples == 0 {
+                return;
+            }
+
+            let mut frames = Vec::with_capacity(n_samples);
+            for i in 0..n_samples {
+                let start = i * mem::size_of::<f32>();
+                let end = start + mem::size_of::<f32>();
+                if end > samples.len() {
+                    break;
+                }
+                let mut bytes = [0u8; 4];
+                bytes.copy_from_slice(&samples[start..end]);
+                frames.push(f32::from_le_bytes(bytes));
+            }
+
+            let total = frames.len();
+            let mut offset = 0;
+            while offset < total {
+                let end = (offset + MAX_FRAMES_PER_PUSH * channels).min(total);
+                let chunk: Vec<f32> = frames[offset..end].to_vec();
+                offset = end;
+                if user_data.tx.send(chunk).is_err() {
+                    break;
+                }
+            }
+        })
+        .register()
+        .context("failed to register pipewire capture stream listener")?;
+
+    // Request F32LE; rate and channel count are left free so PipeWire picks
+    // the native graph settings.
+    let mut audio_info = spa::param::audio::AudioInfoRaw::new();
+    audio_info.set_format(spa::param::audio::AudioFormat::F32LE);
+    let obj = pw::spa::pod::Object {
+        type_: pw::spa::utils::SpaTypes::ObjectParamFormat.as_raw(),
+        id: pw::spa::param::ParamType::EnumFormat.as_raw(),
+        properties: audio_info.into(),
+    };
+    let values: Vec<u8> = pw::spa::pod::serialize::PodSerializer::serialize(
+        std::io::Cursor::new(Vec::new()),
+        &pw::spa::pod::Value::Object(obj),
+    )?
+    .0
+    .into_inner();
+    let mut params = [Pod::from_bytes(&values)
+        .ok_or_else(|| anyhow::anyhow!("failed to build enum format pod"))?];
+
+    stream.connect(
+        spa::utils::Direction::Input,
+        None,
+        pw::stream::StreamFlags::AUTOCONNECT
+            | pw::stream::StreamFlags::MAP_BUFFERS
+            | pw::stream::StreamFlags::RT_PROCESS,
+        &mut params,
+    )?;
+
+    tracing::info!("pipewire audio capture connected to default sink monitor");
+    mainloop.run();
+    tracing::info!("pipewire audio capture stopped");
+
+    Ok(())
+}
